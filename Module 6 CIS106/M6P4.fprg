<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6P4"/>
        <attribute name="authors" value="shama"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-14 11:39:34 AM"/>
        <attribute name="created" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTQ7MTE6Mjc6NTAgQU07MjkxMg=="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTQ7MTE6Mzk6MzQgQU07MTszMDI1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tickets" type="Integer" array="False" size=""/>
            <declare name="priceperticket, totalcost" type="Real" array="False" size=""/>
            <input variable="tickets"/>
            <if expression="tickets&gt;=25">
                <then>
                    <assign variable="priceperticket" expression="50.00"/>
                </then>
                <else>
                    <if expression="tickets&gt;=10 AND tickets&lt;=24">
                        <then>
                            <assign variable="priceperticket" expression="60.00"/>
                        </then>
                        <else>
                            <if expression="tickets&gt;=5 AND tickets&lt;=9">
                                <then>
                                    <assign variable="priceperticket" expression="70.00"/>
                                </then>
                                <else>
                                    <assign variable="priceperticket" expression="75.00"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="totalcost" expression="tickets*priceperticket"/>
            <output expression="&quot;Number of Tickets: &quot; &amp; tickets" newline="True"/>
            <output expression="&quot;Price Per Ticket:  $&quot; &amp; pricePerTicket" newline="True"/>
            <output expression="&quot;Total Cost:        $&quot; &amp; totalCost" newline="True"/>
        </body>
    </function>
</flowgorithm>
